# Gmail SMTP (Nodemailer) — copy to .env.local and fill in values
#
# Gmail App Password setup:
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create App Password: Google Account → Security → 2-Step Verification → App passwords
# 3. Select app "Mail", device "Other", name it "Portfolio"
# 4. Copy the 16-character password (no spaces) into EMAIL_PASS below
#
# EMAIL_USER = Gmail address used to send mail (your inbox)
# EMAIL_PASS = App Password (NOT your regular Gmail password)
# CONTACT_TO_EMAIL = where form submissions are delivered (optional, defaults to EMAIL_USER)

EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_16_char_app_password
CONTACT_TO_EMAIL=your.email@gmail.com
